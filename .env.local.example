# Copy this file to .env.local and fill with your own values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL used in emailed signing links and verification QR codes. Must be the
# deployed Vercel URL, never localhost — even when running the app locally.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Server-side only. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, but required to actually deliver signing invitations.
# Create a verified sender in Resend and use its email address below.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Lawgda <signing@your-verified-domain.com>

# Key Management Server (HashiCorp Vault). Server-only: never prefix with NEXT_PUBLIC_.
VAULT_ADDR=https://your-vm-ip-with-dashes.sslip.io
VAULT_ROLE_ID=
VAULT_SECRET_ID=
