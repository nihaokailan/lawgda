# Copy this file to .env.local and fill in your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-side (service role) key - keep secret and do NOT expose to the browser.
# Only required for operations that need elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
